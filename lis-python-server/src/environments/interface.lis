import "go:context"
import "go:time"

pub interface Runtime {
  fn find(ctx: context.Context, environment_id: string) -> Result<Option<RuntimeInfo>, RuntimeError>
  fn start(ctx: context.Context, spec: RuntimeSpec) -> Result<RuntimeInfo, RuntimeError>
  fn wait_until_ready(
    ctx: context.Context,
    environment_id: string,
    deadline: time.Time,
  ) -> Result<RuntimeInfo, RuntimeError>
  fn wait_until_checkpoint_bound(
    ctx: context.Context,
    checkpoint_name: string,
    deadline: time.Time,
  ) -> Result<(), RuntimeError>
  fn stop(ctx: context.Context, environment_id: string) -> Result<(), RuntimeError>
  fn ensure_checkpoint(ctx: context.Context, spec: RuntimeSpec) -> Result<(), RuntimeError>
  fn delete_checkpoint(ctx: context.Context, environment_id: string) -> Result<(), RuntimeError>
}

pub interface Worker {
  fn startup(ctx: context.Context, runtime: RuntimeInfo) -> Result<DataframeMetadata, WorkerError>
  fn execute(ctx: context.Context, runtime: RuntimeInfo, request: Execution) -> Result<ExecutionResult, WorkerError>
}

pub struct Dataset {
  pub name: string,
  pub relative_path: string,
}

#[json]
pub struct Image {
  pub id: string,
  pub mime: string,
  pub data: string,
}

pub interface DatasetCatalog {
  fn find(name: string) -> Option<Dataset>
  fn names() -> Slice<string>
}

pub struct RuntimeInfo {
  pub environment_id: string,
  pub pod_name: string,
  pub pod_ip: string,
  pub dataset: string,
  pub checkpoint_name: string,
  pub state: RuntimeState,
  pub message: string,
}

pub enum RuntimeState {
  Pending,
  Ready,
  Terminal,
}

pub struct RuntimeSpec {
  pub environment_id: string,
  pub dataset: Dataset,
  pub checkpoint_name: string,
}

#[display]
pub enum RuntimeError {
  CapacityExceeded,
  Conflict,
  Internal(string),
  NotFound,
  Terminated(string),
  TimedOut,
  Unavailable(string),
}

pub struct DataframeMetadata {
  pub available_dataframes: string,
}

#[display]
pub enum WorkerError {
  Authentication,
  CheckpointFailed(string),
  Internal(string),
  InvalidRequest(string),
  InvalidResponse(string),
  TimedOut,
  Unavailable(string),
}
